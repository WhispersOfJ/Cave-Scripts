# Cave-Scripts .env template — KEY NAMES ONLY. Copy to .env (never commit)
# and fill values; the stack's real secrets stay in thebearcave's .env.

# ── *arr / media stack API keys (used by cave-arr-*, cave-plex-*, ...) ──
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
PLEX_TOKEN=
SEERR_API_KEY=

# ── Base-URL overrides (defaults are the direct host ports) ──
RADARR_URL=
SONARR_URL=
PROWLARR_URL=
PLEX_URL=
SEERR_URL=
NZBDAV_URL=

# ── API timeout budgets (seconds) ──
STACK_API_TIMEOUT_LIGHT=
STACK_API_TIMEOUT_MUTATE=
STACK_API_TIMEOUT_HEAVY=

# ── Output ──
# STACK_COLOR=true|false (auto-detected when unset)

# ── Dropbox backups (cave-backup → backup_dropbox.py in thebearcave) ──
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ── Host tools ──
# CAVE_SCRIPTS_DIR (auto-derived from the loader when unset)
# BEARCAVE_REPO_DIR  (thebearcave checkout that owns .env + data backends)
